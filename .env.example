# ====================================================================
# Revox — Environment Variables
# ====================================================================
# Copy this file to ".env" and fill in your API keys.
#   copy .env.example .env        (Windows)
#   cp .env.example .env          (macOS/Linux)
#
# If you leave this unconfigured, Revox defaults to the offline pyttsx3
# TTS engine (no voice cloning, but works out of the box).
# ====================================================================

# ---- Fish Speech (TTS with voice cloning) ----
# A self-hosted Fish Speech server. See: https://fish.audio
# Start the server first (e.g., python -m tools.api --listen 127.0.0.1:8080)
FISH_SPEECH_URL=http://localhost:8080/v1/tts
# Optional: API key if your Fish Speech server requires authentication
# FISH_SPEECH_API_KEY=

# ---- ElevenLabs (cloud TTS with voice cloning) ----
# Get an API key at: https://elevenlabs.io
# ELEVENLABS_API_KEY=xi-...
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# ---- WhisperX transcription ----
# Device: 'cuda' for GPU (recommended) or 'cpu' for fallback
# WHISPER_DEVICE=cuda
# Model size: 'tiny', 'base', 'small', 'medium', 'large-v3'
# WHISPER_MODEL=small

# ---- Video muxing ----
# When set to "1", the original video stream is re-encoded to H.264 instead of
# stream-copied. Slower but can fix players/containers that choke on a direct copy.
# VIDEO_REENCODE=1